{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rm-prime-wri01-hml",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "no_bundle": true,
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs"],
      "fallthrough": true
    },
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [],
  "triggers": {
    "crons": []
  }
}
